# Supabase > Project Settings > Database > Connection string > Session pooler
SUPABASE_DB_URL=postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres
# opcional: sobe o limite da API do GitHub de 60 para 5000 chamadas/h
GITHUB_TOKEN=
# opcionais; o padrao assume as pastas irmas em codigos/
# EMPLOYMENT_DIR=../employment
# RF_EXPORTS_DIR=D:/receita_federal/exports   (padrao; a base da RF fica no HD)

# ── licitacoes / noticias ─────────────────────────────────────────────────────
# Banco de cada pipeline; vazio = SUPABASE_DB_URL. Licitacoes e pequena e o home
# le direto. Noticias guarda o texto inteiro dos artigos (centenas de MB em
# meses) e estoura o plano gratis do Supabase: no docker-compose ela vai para o
# Postgres local.
# LICITACOES_PG_URL=
# NOTICIAS_PG_URL=postgresql://industry:industry@localhost:5433/industry
# Universo de compras publicas (industry/mercado): vazio = Postgres local abaixo,
# nunca o Supabase (milhoes de linhas).
# MERCADO_PG_URL=postgresql://industry:industry@localhost:5433/industry
# Chaves de LLM, lidas pelo roteador industry/shared/llm.py (N = 1..50). Ele faz
# rodizio entre todas as chaves dos provedores que servem o modelo pedido e troca
# de chave sozinho em rate-limit, chave invalida, conta sem credito ou erro.
# Cota diaria da Groq e por CONTA: chaves de contas diferentes somam cota.
GROQ_API_KEY_1=
# GROQ_API_KEY_2=
# CEREBRAS_API_KEY_1=
# MISTRAL_API_KEY_1=
# Selenium remoto (container `selenium` do docker-compose)
SELENIUM_URL=http://localhost:4444
# Arquivos brutos das coletas e relatorios
INDUSTRY_DATA_DIR=./.data
# Ajustes opcionais
# LICITACOES_ZEROSHOT=1            # 0 desliga o mDeBERTa (score usa keyword + LLM)
# LICITACOES_FILTRAR_ANEXO=0       # 1 baixa os PDFs e filtra pelo texto do anexo
# NOTICIAS_CLASSIFICACAO_MODEL=qwen3.8-27b
# MNA_LIMIT=400                    # artigos por rodada no gate zero-shot do M&A

# Relatório de notícias por setor: e-mail DESLIGADO por padrão e sem destinatários.
# Para ligar: NOTICIAS_ENVIO_EMAIL=1 e SMTP. Destinatários fixos em industry/noticias/envio/config.py.
NOTICIAS_ENVIO_EMAIL=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# NOTICIAS_ENVIO_MODEL=qwen3.8-27b
